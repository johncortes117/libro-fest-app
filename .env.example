# ---------------------------------------------------------------------------
# Copia este archivo a `.env.local` y rellena los cuatro valores.
# Sin ellos la agenda pública funciona, pero nadie puede entrar ni guardar.
# ---------------------------------------------------------------------------

# Neon → panel del proyecto → Connection string. Usa la cadena **pooled**
# (el host lleva «-pooler»): es la que aguanta funciones serverless.
DATABASE_URL="postgresql://usuario:clave@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secreto de firma de sesiones. Genera uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="pon-aqui-un-secreto-largo-y-aleatorio"

# La dirección pública definitiva. En local, http://localhost:3000
# Se usa para los callbacks de Google y para las tarjetas de WhatsApp.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITIO="http://localhost:3000"

# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth
# (tipo «Aplicación web»).
#
# URI de redirección autorizado, exactamente:
#   http://localhost:3000/api/auth/callback/google
#   https://TU-DOMINIO/api/auth/callback/google
#
# Y en «APIs habilitadas», activa **Google Calendar API**: sin eso, el
# interruptor de sincronización devuelve error aunque el permiso esté concedido.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
